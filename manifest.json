{
  "manifest_version": 3,
  "name": "Zoom Recording Downloader",
  "version": "0.2.3",
  "description": "開いているZoomクラウド録画を、現在のブラウザ認証で保存します。",
  "minimum_chrome_version": "102",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://zoom.us/*",
    "https://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zoom録画をダウンロード",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
