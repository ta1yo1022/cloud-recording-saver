{
  "manifest_version": 3,
  "name": "Cloud Recording Saver",
  "version": "0.3.0",
  "description": "Zoomの録画ページに対応した、ブラウザ内で動作するクラウド録画保存ツールです。",
  "minimum_chrome_version": "102",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://zoom.us/*",
    "https://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "クラウド録画を保存",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
